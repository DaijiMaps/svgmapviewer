{
  "name": "svgmapviewer",
  "version": "0.8.0",
  "keywords": [
    "SVG",
    "map",
    "viewer"
  ],
  "license": "ISC",
  "author": "Daiji Maps",
  "repository": {
    "url": "https://github.com/DaijiMaps/svgmapviewer"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./address": "./dist/lib/address/index.js",
    "./box": "./dist/lib/box/prefixed/index.js",
    "./carto": "./dist/lib/carto/index.js",
    "./carto-objects": "./dist/lib/carto/objects/index.js",
    "./carto-symbols": "./dist/lib/carto/symbols/index.js",
    "./game": "./dist/lib/game/index.js",
    "./geo": "./dist/lib/geo/index.js",
    "./map": "./dist/lib/map/index.js",
    "./map-floors": "./dist/lib/map/floors/index.js",
    "./matrix": "./dist/lib/matrix/prefixed/index.js",
    "./search": "./dist/lib/search/index.js",
    "./tuple": "./dist/lib/tuple/index.js",
    "./vec": "./dist/lib/vec/prefixed/index.js"
  },
  "scripts": {
    "build": "tsc -b && rslib build",
    "lint": "eslint . && oxlint --type-aware --type-check",
    "publish:jsr": "pnpm dlx jsr publish",
    "test": "rstest",
    "test:dev": "rstest --watch"
  },
  "dependencies": {
    "@xstate/react": "^6.1.0",
    "@xstate/store": "^4.2.3",
    "@xstate/store-react": "^2.1.0",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.113",
    "flatbush": "^4.6.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "type-fest": "^5.10.0",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.14",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^0.23.2",
    "@rstest/core": "^0.11.12",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "happy-dom": "^20.14.6",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*": "oxfmt --write"
  }
}
