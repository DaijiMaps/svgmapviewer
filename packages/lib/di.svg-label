+function RenderFloorLabelTexts({
+  labels,
+}: Readonly<FloorLabelsProps>): ReactNode {
+  const cfg = useConfig()
+  return (
+    <g className="label-texts labels">
+      {labels?.map((_text, idx) => (
+        <Fragment key={idx}>
+          {_text.children?.map((_tspan, idx) => (
+            <g
+              key={idx}
+              className="label"
+              style={
+                {
+                  '--x': (_text.attrs?.['x'] || 0) + 'px',
+                  '--y': (_text.attrs?.['y'] || 0) + 'px',
+                  '--rotate': (_text.attrs?.['rotate'] || 0) + 'deg',
+                  '--scale2': (_text.attrs?.['scale2'] || 1) + '',
+                  '--scale1': (_text.attrs?.['scale1'] || 1) + '',
+                } as CSSProperties
+              }
+            >
+              <text>{_tspan.text ?? ''}</text>
+            </g>
+          ))}
+        </Fragment>
+      ))}
+      <style>{cfg?.floorsConfig?.labelsCircleStyle}</style>
+      <style>{labelsStyle}</style>
+    </g>
+  )
+}
