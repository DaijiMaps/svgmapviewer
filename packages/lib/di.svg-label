+
+const fetchUrlAndPost = (fidx: number, url: string) =>
+  fetch(url)
+    .then((response) => {
+      if (!response.ok) {
+        // XXX retry?
+        throw new Error(`fetch error!`)
+      }
+      return response.blob()
+    })
+    .then((blob) =>
+      blob
+        .arrayBuffer()
+        .then((buf) =>
+          ctx.postMessage(
+            { type: 'FETCH.DONE', fidx, blob, buf },
+            { transfer: [buf] }
+          )
+        )
+    )
+    .catch((e) => console.error(e))
